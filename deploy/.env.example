# Copy to .env next to docker-compose.yml and fill in real values.
# The postgres password is the only required secret here.

# App Postgres password (required) — strong, unique value.
POSTGRES_PASSWORD=change-me

# n8n email + deployment URL (same values already in your n8n env).
GMAIL_USER=yourname@gmail.com
PUBLIC_BASE_URL=https://n8n2.ordrnow.com
